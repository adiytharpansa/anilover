<resources>
    <style name="Theme.Anilover" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#141414</item>
        <item name="android:navigationBarColor">#141414</item>
    </style>
    <style name="Theme.Anilover.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#141414</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Anilover</item>
    </style>
    <style name="Theme.Anilover.Player" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="colorPrimary">#FF141414</item>
        <item name="colorPrimaryDark">#FF000000</item>
        <item name="colorAccent">#FFE50914</item>
    </style>
    <!-- Dipakai khusus tombol Cast: mediarouter wajib punya colorPrimary OPAK,
         bila tidak melempar "background can not be translucent: #0". -->
    <style name="Theme.Anilover.Cast" parent="android:Theme.Material">
        <item name="colorPrimary">#FF141414</item>
        <item name="colorPrimaryDark">#FF000000</item>
        <item name="colorAccent">#FFE50914</item>
    </style>
</resources>
